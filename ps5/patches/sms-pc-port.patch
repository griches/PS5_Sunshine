+Reason: J3DMaterial::getMaterialAnm takes a pointer at or above 0xC0000000 (the end of the cached region on a GameCube) for no animation. With MEM1 moved (PORT_MEM1_REGION_PREFIX, the PS5 has it at 0xC0000000) that was every material animation: no BRK, BTK or BPK took effect, and the plaza gates never revealed their movie. The limit moves with the region.
+--- a/libs/JSystem/include/JSystem/J3D/J3DGraphBase/J3DMaterial.hpp	2026-10-13 20:31:23.797880964 +0100
++++ b/libs/JSystem/include/JSystem/J3D/J3DGraphBase/J3DMaterial.hpp	2026-10-13 20:31:23.812880958 +0100
+@@ -102,7 +102,12 @@
+ 
+ 	J3DMaterialAnm* getMaterialAnm()
+ 	{
++#ifdef PORT_MEM1_REGION_PREFIX
++		// the end of the cached region, a gigabyte above wherever it starts
++		if ((uintptr_t)mMaterialAnm < ((uintptr_t)PORT_MEM1_REGION_PREFIX << 16) + 0x40000000) {
++#else
+ 		if ((uintptr_t)mMaterialAnm < 0xC0000000) {
++#endif
+ 			return mMaterialAnm;
+ 		} else {
+ 			return nullptr;
