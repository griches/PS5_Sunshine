@@ -90,6 +90,18 @@ include(${CMAKE_BINARY_DIR}/decomp_sources.cmake)
 include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/patches.cmake)
 
 set(SMS_COMMON_DEFS GEKKO TARGET_PC VERSION_GMSE01 BUILD_VERSION=2 NDEBUG=1)
+if(PS5)
+  # The PS5 loads a title's C library at 0x80000000: MEM1 is mapped at
+  # 0xC0000000 instead (platform/port_runtime.cpp), and the SDK's address
+  # macros follow (decomp-patches/zzzz-mem1-01-region-prefix.patch). It stays
+  # above 0x80000000 because the game tells its pointers from small numbers
+  # by that line (TDrawSyncManager::threadFunc took a FIFO pointer below it
+  # for its stop message, and the main loop then waited on a dead thread).
+  # And its low 30 bits are zero, because the graphics layer turns a game
+  # address into a "physical" one by keeping those bits (at 0x90000000 the
+  # vertex decoder read 0x10000000 past its arrays).
+  list(APPEND SMS_COMMON_DEFS PORT_MEM1_REGION_PREFIX=0xC000)
+endif()
 set(SMS_GAME_FLAGS
   -w -fno-strict-aliasing -fwrapv -fno-omit-frame-pointer
   # Retail MSL has no _FORTIFY_SOURCE checks (Ubuntu g++ enables them at -O1+;
@@ -121,7 +133,8 @@ endif()
 # Non-PIE: the game's code and data sit at the same addresses every run, which
 # 64-bit builds need for pointers in u32 slots and save states need everywhere
 # (a state holds pointers to the game's vtables and globals).
-if(SMS_ARCH STREQUAL "64" OR CMAKE_SYSTEM_NAME STREQUAL "Linux")
+# (The PS5 only runs position-independent code; its titles load at 0x400000.)
+if((SMS_ARCH STREQUAL "64" OR CMAKE_SYSTEM_NAME STREQUAL "Linux") AND NOT PS5)
   list(APPEND SMS_GAME_FLAGS -fno-pie)
 endif()
 # Clang rejects the game's pointer-to-int truncations ((int)ptr, (u32)ptr) as
@@ -131,6 +144,13 @@ endif()
 if(CMAKE_CXX_COMPILER_ID MATCHES "Clang")
   list(APPEND SMS_GAME_FLAGS -fms-extensions)
 endif()
+# The game's operator new is JKRHeap's, which aligns to 4 or 8 bytes. The PS5's
+# Clang takes operator new to return 16-byte-aligned memory and zeroes two
+# pointer members with one aligned SSE store (M3UModelCommon's constructor
+# faulted there on the console). Tell it the alignment the heap really gives.
+if(PS5)
+  list(APPEND SMS_GAME_FLAGS $<$<COMPILE_LANGUAGE:CXX>:-fnew-alignment=8>)
+endif()
 
 # macOS: native arm64 reserves the low 4 GiB as PAGEZERO, so port_low_alloc
 # cannot satisfy pointer-in-u32. Build x86_64 (Rosetta) with a 4 KiB pagezero.
@@ -300,6 +320,10 @@ elseif(WIN32)
     set(_object_prefix "")
   endif()
   set(SMS_OBJCOPY objcopy)
+elseif(PS5)
+  # Cross-compiled: the payload SDK's objcopy, not the build machine's.
+  set(_object_prefix "")
+  set(SMS_OBJCOPY ${PS5_PAYLOAD_SDK}/bin/llvm-objcopy)
 else()
   set(_object_prefix "")
   set(SMS_OBJCOPY objcopy)
@@ -321,7 +345,7 @@ list(FILTER SMS_PLATFORM_SOURCES EXCLUDE REGEX "/platform/gx/")
 # platform/mods/eclipse is built by cmake/eclipse.cmake, and only with SMS_ECLIPSE.
 list(FILTER SMS_PLATFORM_SOURCES EXCLUDE REGEX "/platform/mods/eclipse/")
 list(FILTER SMS_PLATFORM_SOURCES EXCLUDE REGEX "/tests/")
-if(WIN32 OR APPLE)
+if(WIN32 OR APPLE OR PS5)
   list(FILTER SMS_PLATFORM_SOURCES EXCLUDE REGEX "/platform/trace/trace\\.cpp$")
 endif()
 add_executable(sms ${SMS_PORT_SRC}/port_main.cpp ${SMS_PLATFORM_SOURCES})
@@ -373,13 +397,14 @@ if(WIN32)
     # data. Keep the image below 4 GiB, as on the Linux non-PIE build.
     target_link_options(sms PRIVATE -Wl,--image-base,0x400000 -Wl,--disable-dynamicbase -Wl,--disable-high-entropy-va)
   endif()
-elseif(APPLE)
+elseif(APPLE OR PS5)
   # Apple ld has no --defsym; provide a normal symbol (DSP HLE does not need the GC address).
+  # The PS5 has its C library at that address: a normal symbol there too.
   target_sources(sms PRIVATE ${SMS_PORT_SRC}/lbl_80004600_darwin.c)
 else()
