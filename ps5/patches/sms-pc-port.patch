diff --git a/decomp-patches/zzzz-mem1-01-region-prefix.patch b/decomp-patches/zzzz-mem1-01-region-prefix.patch
new file mode 100644
index 0000000..7741b3b
--- /dev/null
+++ b/decomp-patches/zzzz-mem1-01-region-prefix.patch
@@ -0,0 +1,17 @@
+Reason: the port may map MEM1 somewhere other than 0x80000000 (the PS5 loads a title's C library there). PORT_MEM1_REGION_PREFIX, the upper 16 bits of where it is, moves the cached region the SDK's address macros use; the "uncached" mirror is then the same memory, as it is on any host.
+--- a/libs/dolphin/include/dolphin/os.h
++++ b/libs/dolphin/include/dolphin/os.h
+@@ -38,8 +38,13 @@
+ u32 OSGetConsoleSimulatedMemSize(void);
+ 
+ // Upper words of the masks, since UIMM is only 16 bits
++#ifdef PORT_MEM1_REGION_PREFIX
++#define OS_CACHED_REGION_PREFIX   PORT_MEM1_REGION_PREFIX
++#define OS_UNCACHED_REGION_PREFIX PORT_MEM1_REGION_PREFIX
++#else
+ #define OS_CACHED_REGION_PREFIX   0x8000
+ #define OS_UNCACHED_REGION_PREFIX 0xC000
++#endif
+ #define OS_PHYSICAL_MASK          0x3FFF
+ 
+ #define OS_BASE_CACHED   (OS_CACHED_REGION_PREFIX << 16)
